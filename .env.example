# Servidor
PORT=4000
NODE_ENV=development
# URL del frontend (puede incluir varias separadas por coma)
CORS_ORIGIN=http://localhost:5173

# Seguridad
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Base de datos y archivos
DATABASE_PATH=./data/tienda.db
UPLOAD_DIR=./uploads
PRIVATE_DIR=./private

# Cuentas creadas por `npm run seed`
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_EMAIL=admin@tiens.com
SEED_ADMIN_PASSWORD=Admin123456
SEED_OPERADOR_NOMBRE=Operador
SEED_OPERADOR_EMAIL=operador@tiens.com
SEED_OPERADOR_PASSWORD=Operador123456

# Negocio
BUSINESS_WHATSAPP=573001234567
